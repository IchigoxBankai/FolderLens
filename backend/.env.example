# Backend Configuration
PORT=8000
HOST=0.0.0.0
# Leave DATABASE_URL empty to use automatic embedded SQLite + NumPy vector search fallback
DATABASE_URL=
# Vision model configuration (CLIP base patch 32)
MODEL_NAME=openai/clip-vit-base-patch32
# Visual similarity confidence thresholds (0.0 to 1.0)
MATCH_STRONG_THRESHOLD=0.75
MATCH_WEAK_THRESHOLD=0.60
# Local storage directory for images
STORAGE_DIR=./uploads
# Base URL for static file links
BASE_URL=http://localhost:8000
