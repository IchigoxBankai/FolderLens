# FolderLens Lightweight Backend Configuration
PORT=8000
HOST=0.0.0.0
# Leave DATABASE_URL empty to use automatic embedded SQLite database
# Or set PostgreSQL URL with pgvector (e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=
# Visual similarity confidence thresholds (0.0 to 1.0)
MATCH_STRONG_THRESHOLD=0.75
MATCH_WEAK_THRESHOLD=0.60
# Local storage directory for images
STORAGE_DIR=./uploads
# Base URL for static file links
BASE_URL=http://localhost:8000
